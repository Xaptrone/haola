# openssl rand -base64 32
AUTH_SECRET=

AUTH_TRUST_HOST=true

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Web client
# Authorized JavaScript origins: https://YOUR_DOMAIN  http://localhost:3000
# Authorized redirect URIs:     https://YOUR_DOMAIN/api/auth/callback/google
#                               http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public origin (Coolify, production, or a stable tunnel)
AUTH_URL=https://haola.escor.ai

# Comma-separated Google emails that can open /oversight/manager
FXGEN_MANAGER_EMAILS=shoant.teoh@gmail.com

# Evolution API (same WhatsApp stack as TOAC). Sends the 6-digit login code.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Comma-separated Malaysian mobiles (e.g. 0123456789) that can open /oversight/manager
FXGEN_MANAGER_PHONES=

# Local only — never set in production. Echoes the OTP in the request JSON.
# FXGEN_OTP_ECHO=1

# Email + password accounts (JSON file). Default: .data/users.json
# FXGEN_USERS_PATH=/data/users.json

# Landing hero — public Instagram post or reel URLs (/p/ or /reel/), comma-separated.
# Swipe gallery on the home page. A profile URL is follow-through only, not an auto-feed.
NEXT_PUBLIC_LANDING_INSTAGRAM_URLS=https://www.instagram.com/p/DZuQ6xhz2Au/,https://www.instagram.com/p/DZ6z5UXT_eA/,https://www.instagram.com/p/DaBo88XTLbb/,https://www.instagram.com/p/DaKjxw8TEEZ/,https://www.instagram.com/p/DUu-gYPEhPD/,https://www.instagram.com/p/DUPew4eEz_k/
# NEXT_PUBLIC_LANDING_INSTAGRAM_URL=
# NEXT_PUBLIC_LANDING_INSTAGRAM_CAPTION=
# NEXT_PUBLIC_LANDING_INSTAGRAM_PROFILE=
